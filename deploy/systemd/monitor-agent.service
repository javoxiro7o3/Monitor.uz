# Monitor.uz agent, host mode (Proxmox VE node). Installed by install.sh.
#
# Runs as root with a reduced capability set because the hardware tools
# need it: ssacli (Smart Array), smartctl (SMART), ipmitool (/dev/ipmi0),
# and reading /etc/pve. The agent itself only reads; it opens no
# listening port and only connects out to the hub over HTTPS.
[Unit]
Description=Monitor.uz agent (host)
After=network-online.target pve-cluster.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/lib/monitor-agent/monitor-agent run --mode=host --state-dir=/var/lib/monitor-agent
Restart=always
RestartSec=5
TimeoutStopSec=20
StateDirectory=monitor-agent
StateDirectoryMode=0700
Nice=10

NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE
ProtectSystem=full
ReadWritePaths=/usr/local/lib/monitor-agent
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0077
MemoryMax=150M

[Install]
WantedBy=multi-user.target
