# Monitor.uz hub. Settings live in /etc/monitor-hub/hub.env.
[Unit]
Description=Monitor.uz hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monitor-hub
Group=monitor-hub
EnvironmentFile=/etc/monitor-hub/hub.env
ExecStart=/usr/local/bin/monitor-hub serve --data=/var/lib/monitor-hub
Restart=always
RestartSec=3
StateDirectory=monitor-hub
StateDirectoryMode=0750
LimitNOFILE=65536

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
